{
  "name": "medladder-pages",
  "private": true,
  "version": "1.0.0",
  "description": "Static frontend export of medladder.top, deployed as Cloudflare Worker static assets.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "deploy": "npm run build && wrangler deploy",
    "preview": "npm run build && wrangler dev",
    "build:android:web": "node tools/build-android-web.cjs",
    "android:sync": "npm run build:android:web && cap sync android",
    "live-update": "node tools/publish-live-update.cjs"
  },
  "devDependencies": {
    "esbuild": "0.24.2",
    "@capacitor/cli": "^8.5.2",
    "adm-zip": "^0.5.16",
    "@aws-sdk/client-s3": "^3.700.0"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capgo/capacitor-updater": "^8.54.2"
  }
}

# Clean URLs are real directories (privacy/index.html etc.), served by
# directory index — no rewrite rules needed for them.
# .html URLs redirect to the clean form; /download-apk redirects to the APK.
/ini-cet    /inicet    301
/index.html    /    301
/privacy.html    /privacy    301
/terms.html    /terms    301
/mock-test.html    /mock-test    301
/admin-mock.html    /admin-mock    301
/neet-ss-books.html    /neet-ss-books    301
/landing.html    /landing    301
/download-apk    /MedLadder-latest.apk    302
# No AI-agent catalog is offered, so the ARD well-known paths must 404
# instead of falling through to the SPA shell (HTML with 200), which
# Lighthouse 13.5 reads as an invalid ai-catalog.json schema.
/.well-known/ai-catalog.json    /    404
/.well-known/ard.json    /    404

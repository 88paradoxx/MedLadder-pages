{
  "name": "medladder-pages",
  "compatibility_date": "2026-10-25",
  "main": "worker.js",
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/upload-image"
    ]
  },
  "r2_buckets": [
    {
      "binding": "IMAGES_BUCKET",
      "bucket_name": "medladder-images"
    }
  ],
  "observability": {
    "enabled": false
  }
}
